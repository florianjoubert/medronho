# --- Required -----------------------------------------------------------------
# Absolute path to your Markdown vault (a directory of .md files).
VAULT_PATH=~/vault
# Path to the SQLite database (created on first index run).
DB_PATH=~/.secondbrain/secondbrain.db

# --- Inference (defaults target local Ollama) ----------------------------------
# Any OpenAI-compatible endpoint works; point this at a cloud API to opt out
# of local inference.
LLM_BASE_URL=http://localhost:11434/v1
# Ignored by Ollama, required by cloud providers.
LLM_API_KEY=ollama
LLM_CHAT_MODEL=qwen3.6:35b-a3b
LLM_EMBED_MODEL=nomic-embed-text

# --- Embeddings -----------------------------------------------------------------
# Vector dimension of LLM_EMBED_MODEL (nomic-embed-text: 768). The index is
# locked to (model, dim); changing either requires `secondbrain index --rebuild`.
EMBED_DIM=768
# Task prefixes prepended at embedding time (never stored). nomic-embed-text is
# trained with these; set both to empty strings for models that use none.
EMBED_DOCUMENT_PREFIX="search_document: "
EMBED_QUERY_PREFIX="search_query: "
